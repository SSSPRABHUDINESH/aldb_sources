Setup SSL Communication:

Create a Certificate Authority (CA)

openssl genrsa -out root.key 4096;
	openssl req -x509 -new -nodes -key root.key -sha256 -days 3650 -subj '/C=US/ST=CA/O=signer,Inc./CN=signer.com' -out root.crt;

	Generate a Server Key for PostgreSQL

	openssl genrsa -out postgres.key 2048;

	Generate a CSR (certificate signing request) for PostgreSQL:

	export san_entry=DNS:aman-db1,DNS:10.1.0.2,IP:10.1.0.2;
echo -e "\n[alt_names]\nsubjectAltName=$san_entry" | tee -a myopenssl.cnf;
openssl req -new -sha256 -key postgres.key -subj '/C=US/ST=CA/O=myorg,Inc./CN=google.com' -out postgres.csr -config myopenssl.cnf -reqexts alt_names;

	Sign the server certificate using the CA:

	openssl x509 -req -in postgres.csr -CA root.crt -CAkey root.key -CAcreateserial -out server.crt -days 365 -sha256 -extfile myopenssl.cnf -extensions alt_names;

	sudo cp server.crt postgres.key /var/lib/postgresql/16/data;
	sudo chown postgres:postgres /var/lib/postgresql/16/data/postgres.key;
sudo chmod 0600 /var/lib/postgresql/16/data/postgres.key;
	

	Add below entry in /var/lib/postgresql/16/data/postgresql.conf
	ssl = on
ssl_cert_file = 'server.crt'
ssl_key_file = 'postgres.key'


	sudo systemctl restart alloydbomni-16;
sudo systemctl status alloydbomni-16;


	PGPASSWORD=abcdefgh psql -h localhost -d postgres -U postgres -v sslmode=verify-full -v sslrootcert=/home/mehtaaman_google_com/root.crt
	PGPASSWORD=abcdefgh psql -h aman-db1 -d postgres -U postgres -v sslmode=verify-full -v sslrootcert=/home/mehtaaman_google_com/root.crt	



Pgbouncer Performance Testing:
Result: Performance using Pgbouncer is better than using postgres client
sudo dnf install -y sysbench
	sysbench \
    --db-driver=pgsql \
    --pgsql-host=10.1.0.2 \
    --pgsql-port=5432 \
    --pgsql-user=postgres \
    --pgsql-password=abcdefgh \
    --pgsql-db=sampledb \
    oltp_common \
    prepare
	
	Expected Outcome:
	1. Higher TPS = better performance under load
2. Higher QPS is typically an indicator of better query performance.
3. Lower average latency and smaller standard deviation in PgBouncer results indicate better performance.
4. Lower fairness standard deviation = better load balancing.



Via Postgres
	sysbench \
    --db-driver=pgsql \
    --pgsql-host=10.1.0.2 \
    --pgsql-port=5432 \
