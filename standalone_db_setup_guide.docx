Restore Data PITR:

sudo systemctl stop alloydbomni-16;
sudo rm -rf /var/lib/postgresql/16/data;
sudo mkdir -p /var/lib/postgresql/16/data;
sudo chown -R postgres:postgres /var/lib/postgresql/16/data;
sudo chmod 0700 /var/lib/postgresql/16/data;

sudo -u postgres pgbackrest --config=/etc/pgbackrest.conf --stanza=standalone  --type=time --target="2025-07-12 09:23:16" --target-action=promote restore

sudo systemctl start alloydbomni-16

Able to see 7 records


Setup Pgbouncer on DB Node:

	sudo dnf install pgbouncer

	Add below config in file /etc/pgbouncer/pgbouncer.ini
	sudo rm /etc/pgbouncer/pgbouncer.ini
	sudo vi /etc/pgbouncer/pgbouncer.ini
	[pgbouncer]
# Log settings
logfile = /var/log/pgbouncer/pgbouncer.log
pidfile = /var/run/pgbouncer/pgbouncer.pid
# Network settings
listen_addr = 0.0.0.0
listen_port = 6432
# Authentication settings
auth_type = md5
auth_file = /etc/pgbouncer/userlist.txt
admin_users = postgres
# Pooling settings
pool_mode = transaction
default_pool_size = 100
reserve_pool_size = 20
max_client_conn = 2000
server_idle_timeout = 300
# Connection retry and timeout settings
query_timeout = 3600
server_connect_timeout = 30
server_login_retry = 10
server_idle_timeout = 10
server_reset_query = DISCARD ALL
# TLS/SSL settings - Remove if not using HTTPS
# client_tls = 1
# client_tls_key_file = /etc/pgbouncer/server.key
# client_tls_cert_file = /etc/pgbouncer/server.crt
# client_tls_ca_file = /etc/pgbouncer/ca.crt
[databases]
* = host=127.0.0.1 port=5432

Generate MD5 Hash by logging to postgres DB and run below query
SELECT 'md5' || md5('<plain-text-password><username>');
SELECT 'md5' || md5('mypasswordtestuser');
	

	Create user file
	sudo vi /etc/pgbouncer/userlist.txt
	"postgres" "md5e32ec1ffd4ac45421106f49872f390a3"


sudo chmod 600 /etc/pgbouncer/userlist.txt
sudo chown pgbouncer:pgbouncer /etc/pgbouncer/userlist.txt
sudo mkdir -p /var/log/pgbouncer
sudo chown pgbouncer:pgbouncer /var/log/pgbouncer
	sudo systemctl enable pgbouncer
	sudo systemctl start pgbouncer
	sudo systemctl status pgbouncer

